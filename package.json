{
  "name": "cut-and-collect",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "author": "Rishi Gandhi",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -k \"npm:server\" \"npm:dev\"",
    "dev:lan": "concurrently -k \"npm:server\" \"vite --host\"",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "play:online": "concurrently -k \"npm:server\" \"npm:tunnel\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm:server\" \"vite\" \"wait-on tcp:5173 && electron .\"",
    "package": "vite build && electron-builder --dir",
    "package:dist": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.rishigandhi.cutandcollect",
    "productName": "Cut & Collect",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "leaderboard-store.js",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rishi-Gandhi",
        "repo": "Cut-and-Collect-420-Card-Game-"
      }
    ],
    "mac": {
      "category": "public.app-category.card-games",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game"
    }
  }
}
