{
  "name": "cut-and-collect",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "package": "vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.1",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.rishigandhi.cutandcollect",
    "productName": "Cut & Collect",
    "files": ["dist/**/*", "electron/**/*", "leaderboard-store.js", "package.json"],
    "directories": { "output": "release" },
    "mac": { "target": "dir" }
  }
}
